@startuml
title Вариант №26 · Диаграмма классов
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 13
skinparam defaultFontColor #142638
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam ArrowColor #526D82
skinparam classBackgroundColor #F1F6FA
skinparam classBorderColor #526D82
skinparam packageBackgroundColor #FFFFFF
skinparam packageBorderColor #B0C2D0
hide empty members
top to bottom direction

package "Управление моделью" {
  class Simulator {
    - sources: List<Source>
    - devices: List<Device>
    - buffer: Buffer
    - placement: PlacementDispatcher
    - selection: SelectionDispatcher
    - calendar: EventCalendar
    - stats: StatisticsCollector
    - now: Time
    - remaining: int
    + initialize(config: TrialConfig): void
    + step(): StepSnapshot?
    + snapshot(): StepSnapshot
    + run(): RunReport
  }

  class EventCalendar {
    - events: Heap<Event>
    - nextSerial: int
    + scheduleArrival(at: Time, sourceId: int): void
    + scheduleCompletion(at: Time, deviceId: int): void
    + popNext(): Event?
    + discardArrivals(): void
    + snapshot(): List<Event>
  }

  class Event {
    - at: Time
    - kind: EventKind
    - originId: int
    - serial: int
    + Event(at: Time, kind: EventKind, originId: int, serial: int)
    + time(): Time
    + kind(): EventKind
    + originId(): int
    + sortKey(): EventKey
  }
}

package "Приём и распределение" {
  class PlacementDispatcher {
    - buffer: Buffer
    - stats: StatisticsCollector
    + place(q: Request, now: Time): void
  }

  class SelectionDispatcher {
    - buffer: Buffer
    - devices: List<Device>
    - calendar: EventCalendar
    - stats: StatisticsCollector
    - nextDevice: int
    - nextSlot: int
    + dispatch(now: Time): void
    + devicePointer(): int
    + bufferPointer(): int
    - findFreeDevice(): int?
    - advancePointers(p: int, j: int): void
  }

  class Buffer {
    - slots: Array<Request?>
    - placementOrder: int
    + findFirstFree(): int?
    + findNewest(): int?
    + findOccupied(fromSlot: int): int?
    + peek(j: int): Request
    + put(j: int, q: Request, now: Time): void
    + take(j: int): Request
    + snapshot(): List<SlotState>
  }
}

package "Датчики и вычислительные узлы" {
  class Source {
    - id: int
    - lastNumber: int
    - kind: MeasurementKind
    - a: Time
    - b: Time
    - rng: Random
    + generate(now: Time): Request
    + sampleInterval(): Time
    + snapshot(): SourceState
  }

  class Request {
    - sourceId: int
    - number: int
    - kind: MeasurementKind
    - value: real
    - generatedAt: Time
    - queuedAt: Time?
    - placementOrder: int?
    - startAt: Time?
    - endedAt: Time?
    - outcome: Outcome?
    + Request(sourceId: int, number: int, kind: MeasurementKind, value: real, now: Time)
    + sourceId(): int
    + placementOrder(): int?
    + markQueued(now: Time, order: int): void
    + markDropped(now: Time): void
    + markStarted(now: Time): void
    + markCompleted(now: Time): void
    + snapshot(): RequestState
  }

  class Device {
    - id: int
    - rate: real
    - rng: Random
    - current: Request?
    - dueAt: Time?
    + isFree(): bool
    + start(q: Request, now: Time): Time
    + complete(now: Time): Request
    + release(): void
    + snapshot(): DeviceState
    - sampleDuration(): Time
  }
}

class StatisticsCollector {
  - bySource: Map<int, SourceTotals>
  - byDevice: Map<int, DeviceTotals>
  - journal: List<Transition>
  + recordGenerated(q: Request, now: Time): void
  + recordQueued(q: Request, now: Time, j: int): void
  + recordDrop(q: Request, now: Time, j: int): void
  + recordStart(q: Request, now: Time, j: int, p: int): void
  + recordCompletion(q: Request, now: Time, p: int): void
  + journalSize(): int
  + transitions(range: IndexRange): List<Transition>
  + report(now: Time, devices: List<DeviceState>): RunReport
}

Simulator "1" *-- "1" EventCalendar
EventCalendar "1" *-right- "0..*" Event
Simulator "1" *-- "1" PlacementDispatcher
Simulator "1" *-- "1" SelectionDispatcher
Simulator "1" *-- "1" Buffer
Simulator "1" *-- "1..*" Source
Simulator "1" *-- "1..*" Device
Simulator "1" *-- "1" StatisticsCollector
PlacementDispatcher "1" --> "1" Buffer
SelectionDispatcher "1" --> "1" Buffer
SelectionDispatcher "1" --> "1..*" Device
SelectionDispatcher "1" --> "1" EventCalendar
PlacementDispatcher "1" --> "1" StatisticsCollector
SelectionDispatcher "1" --> "1" StatisticsCollector
Source "1" -- "0..*" Request : датчик по sourceId
Buffer "0..1" --> "0..B" Request : ожидают
Device "0..1" --> "0..1" Request : обслуживается
StatisticsCollector ..> Request : принимает в методы
@enduml
