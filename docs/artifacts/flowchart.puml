@startuml
title Вариант №26 · Блок-схема событийного процесса
skinparam defaultFontName Helvetica
skinparam titleFontSize 22
skinparam defaultFontSize 15
skinparam shadowing false
skinparam ArrowColor #31526A
skinparam swimlaneBorderColor #B3C4CF
skinparam swimlaneTitleBackgroundColor #DFECF4
skinparam activity {
  BackgroundColor #EDF4F8
  BorderColor #58748A
  DiamondBackgroundColor #FFF7DF
  DiamondBorderColor #C7AA62
}

|#FFFFFF|Src|Источник
|#F4F8FB|Place|Диспетчер постановки
|#FFFFFF|Buf|Буфер
|#F4F8FB|Stats|Сбор статистики
|#FFFFFF|Sim|Симулятор и календарь
|#F4F8FB|Select|Диспетчер выбора
|#FFFFFF|Dev|Прибор

|Sim|
start
:Инициализировать часы и систему\nУБ = УП = 1;
|Src|
:Выбрать первые интервалы ИЗ2\nτ = a + (b − a) × U, U ∈ [0, 1), 0 < a < b;
|Sim|
:Запланировать\nпервые генерации;
while (В календаре есть событие?) is (да)
  :Извлечь ближайшее событие\nи перевести модельные часы;
  if (Событие генерации?) then (да)
    |Src|
    :Создать заявку r (ИБ);
    |Stats|
    :Учесть генерацию;
    |Sim|
    if (Достигнут лимит генераций?) then (да)
      :Отменить оставшиеся генерации;
    else (нет)
      |Src|
      :Выбрать следующий интервал τ по ИЗ2;
      |Sim|
      :Запланировать генерацию на now + τ;
    endif
    |Place|
    :Принять новую заявку r;
    |Buf|
    :Начать поиск с ячейки 1 (Д1ОЗ3);
    while (Ячейка в пределах 1…N\nи занята?) is (да)
      :Проверить следующую ячейку;
    endwhile (нет)
    if (Есть свободная позиция j?) then (да)
      :Запомнить позицию j;
    else (буфер полон)
      |Place|
      :Запросить выбор жертвы (Д1ОО4);
      |Buf|
      :Найти максимум номера\nпостановки и выбить заявку;
      |Stats|
      #FBEDEB:Зафиксировать отказ\nу источника выбитой заявки;
    endif
    |Buf|
    :Записать r в j\nс новым номером;
    |Sim|
    :Триггер «заявка в буфере»;
  else (завершение)
    |Dev|
    :Завершить обслуживание,\nотметить выход и освободиться;
    |Stats|
    :Учесть выход, времена\nзаявки и занятость;
    |Sim|
    :Триггер «прибор освободился»;
  endif

  |Select|
  :Начать обход приборов от УП (Д2П2);
  while (Есть непроверенный прибор\nи свободный ещё не найден?) is (да)
    |Dev|
    :Проверить занятость прибора p;
    |Select|
    :При занятости перейти к следующему,\nпосле M вернуться к 1;
  endwhile (нет)
  if (Нашли свободный прибор p?) then (да)
    |Buf|
    :Начать обход буфера от УБ (Д2Б3);
    while (Есть непроверенная ячейка\nи заявка ещё не найдена?) is (да)
      :Проверить ячейку j. Если она пуста,\nпродолжить, после N вернуться к 1;
    endwhile (нет)
    if (Нашли заявку?) then (да)
      :Извлечь заявку из j\nУБ ← 1 + (j mod N);
      |Select|
      :Передать заявку прибору p;
      |Dev|
      :Отметить старт, занять прибор\nПЗ1 · t = −ln(U) / μ, U ∈ (0, 1), μ > 0;
      |Select|
      :УП ← 1 + (p mod M);
      |Stats|
      :Зафиксировать старт и начало занятости;
      |Sim|
      :Запланировать завершение на now + t;
    else (буфер пуст)
      |Select|
      :Сохранить указатели.\nПрибор свободен.;
    endif
  else (все заняты)
    |Select|
    :Оставить заявки ждать.\nПовторить выбор по триггеру.;
  endif
  |Sim|
  :Зафиксировать снимок состояния для ОД2;
endwhile (нет)
|Stats|
:Рассчитать итоговые показатели ОР1;
stop
@enduml
