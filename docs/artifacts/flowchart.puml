@startuml
title Вариант №26 · Обработка событий
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 13
skinparam defaultFontColor #142638
skinparam shadowing false
skinparam ArrowColor #526D82
skinparam activityBackgroundColor #F1F6FA
skinparam activityBorderColor #526D82
skinparam activityDiamondBackgroundColor #EDF3F7
skinparam swimlaneBorderColor #B0C2D0

|Cal| Календарь событий
|Src| Датчик
|Place| Приёмщик телеметрии
|Buf| Буфер
|Sel| Планировщик
|Dev| Вычислительный узел
|Stats| Статистика

|Cal|
start
:Запланировать первые генерации
от времени 0 (ИБ, ИЗ2);
note right
  Календарём и лимитом управляет Simulator.
end note
while (Календарь содержит событие?) is (да)
  :Взять ближайшее событие
и установить модельное время;
  if (Событие — генерация?) then (да)
    |Src|
    :Сформировать измерение
из независимого потока (ИБ);
    |Stats|
    :Записать генерацию;
    |Cal|
    :Уменьшить остаток лимита прогона;
    if (Остаток лимита положителен?) then (да)
      |Src|
      :Получить равномерный интервал (ИЗ2);
      |Cal|
      :Назначить следующую генерацию;
    else (нет)
      :Прекратить генерацию и удалить
оставшиеся записи прихода;
    endif
    |Place|
    :Принять новое измерение;
    |Buf|
    :Начать просмотр с ячейки 1 (Д1ОЗ3);
    while (Текущая ячейка занята\nи остались ячейки?) is (да)
      :Перейти к следующей ячейке;
    endwhile (нет)
    if (Найдена свободная ячейка?) then (да)
    else (нет)
      |Place|
      :Выбрать ожидающее сообщение
с наибольшим номером постановки (Д1ОО4);
      :Зафиксировать время отказа;
      |Stats|
      :Учесть отказ у датчика
выбранного сообщения;
      |Buf|
      :Освободить выбранную ячейку;
    endif
    |Buf|
    :Записать новое измерение
и присвоить номер постановки;
    |Stats|
    :Записать постановку;
  else (завершение)
    |Dev|
    :Завершить обработку
и отметить сохранение;
    |Stats|
    :Учесть завершение
у датчика и узла;
    |Dev|
    :Освободить узел;
  endif

  |Sel|
  :Запустить подбор после
постановки или освобождения;
  while (Продолжить подбор?) is (да)
    :Начать обход приборов от УП (Д2П2);
    while (Прибор занят и остались\nнепроверенные позиции?) is (да)
      :Перейти к следующему прибору
через 1 после последнего;
    endwhile (нет)
    if (Свободный прибор найден?) then (да)
      |Buf|
      :Начать обход ячеек от УБ (Д2Б3);
      while (Ячейка пуста и остались\nнепроверенные позиции?) is (да)
        :Перейти к следующей ячейке
через 1 после последней;
      endwhile (нет)
      if (Занятая ячейка найдена?) then (да)
        :Извлечь сообщение
из найденной ячейки;
        |Dev|
        :Начать обработку и получить
экспоненциальную длительность (ПЗ1);
        |Sel|
        :Передвинуть УП и УБ
на позиции после найденных;
        |Cal|
        :Запланировать завершение;
        |Stats|
        :Записать выбор и начало обработки;
        |Sel|
        :Повторить подбор;
      else (нет)
        |Sel|
        :Закончить подбор, буфер пуст.
Указатели остаются на местах;
      endif
    else (нет)
      :Закончить подбор, узлы заняты.
Указатели остаются на местах;
    endif
  endwhile (нет)
  |Stats|
  :Собрать состояние и журнал события (ОД2);
  |Cal|
endwhile (нет)
|Stats|
:Проверить нулевой лимит,
пустой буфер и свободные узлы;
if (Все условия выполнены?) then (да)
  :Завершить моделирование.
Сформировать две таблицы (ОР1);
else (нет)
  :Зафиксировать ошибку состояния;
endif
stop
@enduml
