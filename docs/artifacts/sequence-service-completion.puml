@startuml
title Вариант №26 · Завершение обработки и повторный выбор
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 13
skinparam defaultFontColor #142638
skinparam shadowing false
skinparam ArrowColor #38566D
skinparam sequenceLifeLineBorderColor #97ABBA
skinparam sequenceParticipantBackgroundColor #F1F6FA
skinparam sequenceParticipantBorderColor #526D82
skinparam sequenceGroupBorderColor #8095A5
skinparam sequenceGroupBackgroundColor #EDF3F7
skinparam noteBackgroundColor #FFF5D9
skinparam noteBorderColor #B09354
hide footbox

control "Управление\nмоделью" as Sim
queue "Календарь\nсобытий" as Cal
participant "Узел П₁" as P1
participant "Статистика" as Stats
control "Планировщик" as Sel
participant "Общий\nбуфер" as Buf

Sim -> Cal : popNext()
Cal --> Sim : COMPLETION(6, П₁)
Sim -> P1 : complete(6)
P1 --> Sim : A1, отметка завершения 6
Sim -> Stats : recordCompletion(A1, 6, 1)
Sim -> P1 : release()
Sim -> Sel : dispatch(6)
Sel -> Sel : findFreeDevice() · Д2П2, от УП = 1
Sel -> P1 : isFree()
P1 --> Sel : да
Sel --> Sel : выбран П₁
Sel -> Buf : findOccupied(2) · Д2Б3, от УБ = 2
alt Заявка найдена (ручной сценарий)
  Buf --> Sel : ячейка 2
  Sel -> Buf : take(2)
  Buf --> Sel : B2
  Sel -> P1 : start(B2, 6) · ПЗ1
  P1 --> Sel : 9
  Sel -> Sel : advancePointers(1, 2) · УП = 2, УБ = 3
  Sel -> Cal : scheduleCompletion(9, 1)
  Sel -> Stats : recordStart(B2, 6, 2, 1)
  note over Sel, P1 : Оба прибора заняты, дальнейшей передачи нет.
else Буфер пуст
  Buf --> Sel : нет занятой ячейки
  note over Sel, Buf : Прибор остаётся свободным, УП и УБ прежние.
end
@enduml
